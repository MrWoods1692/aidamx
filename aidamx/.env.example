# ============================================
# aidamx 环境变量配置示例
# 复制此文件为 .env 并填入实际值
# ============================================

# ============================================
# 数据库配置 (MySQL)
# ============================================
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_database_password
DB_NAME=aidamx

# ============================================
# JWT 密钥
# 用户认证使用的密钥，请替换为随机生成的强密钥
# 生成方式: openssl rand -base64 32
# ============================================
JWT_SECRET=your_user_jwt_secret_here

# 管理员认证使用的密钥，请替换为随机生成的强密钥
# 生成方式: openssl rand -base64 32
# ============================================
ADMIN_JWT_SECRET=your_admin_jwt_secret_here

# ============================================
# 管理员验证码
# 管理员登录时需要输入的验证码
# ============================================
ADMIN_CODE=your_admin_code_here

# ============================================
# 邮件配置 (QQ邮箱)
# 用于发送注册验证码和找回密码邮件
# EMAIL_USER: QQ邮箱地址
# EMAIL_AUTH_CODE: QQ邮箱授权码（非登录密码）
# 获取授权码: QQ邮箱 -> 设置 -> 账户 -> 开启SMTP -> 生成授权码
# ============================================
EMAIL_USER=your_email@qq.com
EMAIL_AUTH_CODE=your_email_auth_code

# ============================================
# 站点配置
# 站点访问地址，用于生成找回密码等链接
# ============================================
NEXT_PUBLIC_SITE_URL=http://localhost:6677
